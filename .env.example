# Copy to .env and fill in from your Supabase project (Settings > API; the
# URL is https://<project-ref>.supabase.co), or from `supabase status` when
# running the local stack. Restart `bun dev` after editing: Vite reads these
# values only when the dev server starts.

# Browser: public anon key only.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Python worker and importer (prosody/prosody_worker). Loaded from this
# file; variables set in the shell win. No VITE_ prefix, so Vite never
# bundles them. Never expose the service-role key to the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
PROSODY_ANALYZER_VERSION=1
